{
  "name": "oilline-watch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.2"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:wasm": "node tools/build-oil-wasm.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.tools.json",
    "lint": "eslint .",
    "test:unit": "vitest run tests/unit",
    "test:coverage": "vitest run tests/unit --coverage",
    "test:e2e": "playwright test",
    "check:boundaries": "tsx tools/check-boundaries.ts",
    "diagnostic:hashes": "tsx tools/diagnostic-source-hashes.ts",
    "package:demo": "tsx tools/package-release.ts --demo",
    "replay:inference": "tsx tools/replay-inference.ts",
    "verify": "node tools/verify.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "@webgpu/types": "0.1.74",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
